# Copy to .env and fill in. Never commit .env.

# Bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=

# Right-click your server -> Copy Server ID (needs Developer Mode on).
DISCORD_GUILD_ID=1346908926855221372

# One forum channel per category. Right-click each channel -> Copy Channel ID.
# These must be Forum channels, not text channels.
FORUM_CHEAT_CLIENT=1386320274722525244
FORUM_MACRO_CLIENT=1348584001186697216
FORUM_LEGIT_MOD=1386320418964770876
FORUM_SHOP=1347589934445494312
FORUM_OTHER=1401560169414000650

# Regular text channel where reviews are posted.
REVIEWS_CHANNEL_ID=1531987704844124250

# Shared secret; must match DISCORD_BOT_SECRET in the website's .env.local.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_SHARED_SECRET=

# Port this bot listens on for events from the website.
PORT=8787

# Public URL of the website, used for links back to listings in embeds.
SITE_URL=http://localhost:3000

# Where the bot stores its listing-id -> Discord-post mapping.
DATABASE_FILE=./qolhelper.db
